@model TimeTableModel

@{
    //page title
    ViewBag.PageTitle = T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.ManageAvailableDeliveryDateTimeCapacities").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Delsami.DeliveryScheduling.ManageAvailableDeliveryDateTimeCapacities");

    Layout = "_AdminLayout";

    NopHtml.AppendCssFileParts(string.Format(Constants.PluginOutputPath + Constants.DeliverySchedulingCssPath + "{0}", "adminStyle.css"));
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.TimeTable.Capacities")
        </h1>
    </div>

    if (Model.HasConfirmedTimeRange)
    {
        <div class="content-header">
            <div class="well">@T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.ManageAvailableDeliveryDateTimeCapacities.Hint")</div>
        </div>
    }

    <section class="content">
        <div class="container-fluid">
            @if (Model.HasConfirmedTimeRange)
            {
                <div class="form-horizontal">
                    <div class="cards-group">
                        <div class="card card-default card-search">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-5">
                                        @if (Model.AvailableStores.Count() > 1)
                                        {
                                            <div class="form-group row">
                                                <div class="col-md-6">
                                                    <div class="label-wrapper">
                                                        <label class="control-label">
                                                            @T("Admin.Configuration.Settings.StoreScope")
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <nop-select asp-for="StoreId" asp-items="@Model.AvailableStores" style="width: auto;min-width: 300px;" />
                                                </div>
                                            </div>
                                        }
                                        <div class="form-group row">
                                            <div class="col-md-6">
                                                <nop-label asp-for="ShippingMethodId" />
                                            </div>
                                            <div class="col-md-6">
                                                <nop-select asp-for="ShippingMethodId" asp-items="@Model.AvailableShippingMethods" style="width: auto;min-width: 300px;" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-horizontal">
                    <div id="TimeTable">
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">@T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.TimeTable.HasNotConfimedTimeRange")</div>
            }
        </div>
    </section>
}

<script>
    $(document).ready(function () {
        if ("@Model.StoreId" && "@Model.ShippingMethodId") {
            LoadTimeTable(@Model.ShippingMethodId, @Model.StoreId)
        }
        $("#ShippingMethodId,#StoreId").on("change", function () {
            var storeId = null;
            if ($("#StoreId").length != 0) {
                storeId = $("#StoreId").val();
            }
            var storeId = $("#StoreId").val();
            var shippingMethodId = $("#ShippingMethodId").val();
            if (($("#StoreId").length != 0 && storeId) || $("#StoreId").length == 0 && shippingMethodId) {
                LoadTimeTable(shippingMethodId, storeId)
            }
        });

        function LoadTimeTable(shippingMethodId, storeId) {
            if (shippingMethodId != 0) {
                var url = '@Url.Action("TimeTableList", "DeliverySchedulingAdmin", new { area = "Admin", shippingMethodId = "__SM__" })';
                url = url.replace("__SM__", shippingMethodId);

                if (storeId) {
                    url += "&storeId=" + storeId;
                }

                $("#TimeTable").load(url);
            } else {
                $("#TimeTable").empty();
            }
        }
    });
</script>
