@model ExceptionDateModel

@{
    Layout = null;

    int j = 0;
}

<a style="margin:15px 0" class="btn btn-info" href='javascript:OpenWindow("@Url.Content("~/Admin/Plugin/DeliveryScheduling/DeliverySchedulingAdmin/TimeTablePopup")?storeId=@Model.StoreId&shippingMethodId=@Model.SelectedShippingMethodId", 800, 320, true);'>@T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.LoadTimeTableText")</a>

<table class="table table-bordered  table-striped time-table">
    <thead>
        <tr>
            @foreach (var availableDeliveryTimeRange in Model.AvailableDeliveryTimeRanges.OrderBy(o => o.DisplayOrder))
            {
                <th>@availableDeliveryTimeRange.Time</th>
            }
        </tr>
    </thead>
    <tbody>
        <tr>
            @foreach (var timeRange in Model.TimeRanges)
            {
                <td>
                    <input class="form-control" name="TimeRanges[@j].Capacity" value="@timeRange.Capacity" />
                    <input name="TimeRanges[@j].ShippingMethodCapacityId" value="@timeRange.ShippingMethodCapacityId" type="hidden" />
                </td>
                j++;
            }
        </tr>
    </tbody>
</table>
