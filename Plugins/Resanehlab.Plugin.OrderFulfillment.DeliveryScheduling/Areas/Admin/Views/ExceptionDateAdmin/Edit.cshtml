@model ExceptionDateModel

@{
    //page title
    ViewBag.PageTitle = T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.ExceptionDate.EditDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Delsami.DeliveryScheduling.ManageExceptionDates");

    Layout = "_AdminLayout";
}

@using (Html.BeginForm(null, null, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.ExceptionDate.EditDetails")
            <small><i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.ExceptionDate.BackToList").Text, "List")</small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Delsami.OrderFulfillment.DeliveryScheduling/Areas/Admin/Views/ExceptionDateAdmin/_CreateOrUpdate.cshtml", Model)
}
