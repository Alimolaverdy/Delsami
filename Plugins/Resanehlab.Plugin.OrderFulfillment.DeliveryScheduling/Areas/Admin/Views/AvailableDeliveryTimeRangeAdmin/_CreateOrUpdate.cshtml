@model AvailableDeliveryTimeRangeModel

@inject Nop.Services.Common.IGenericAttributeService genericAttributeService
@inject Nop.Core.IWorkContext workContext

@Html.ValidationSummary(false)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.StoreId)

@{
    const string hideInfoBlockAttributeName = "Delsami.DeliveryScheduling.AvailableDeliveryTimeRangePage.HideInfoBlock";
    var hideInfoBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideInfoBlockAttributeName);
}

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <nop-cards id="available-delivery-times-cards">
                <nop-card asp-name="available-delivery-times-info" asp-icon="fas fa-info" asp-title="@T("Delsami.Plugin.OrderFulfillment.DeliveryScheduling.AvailableDeliveryTimeRange.AvailableDeliveryTime")" asp-hide-block-attribute-name="@hideInfoBlockAttributeName" asp-hide="@hideInfoBlock" asp-advanced="false">
                    <div class="card-body">
                       
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="StartHour" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="StartHour" />
                                <span asp-validation-for="StartHour"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="EndHour" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="EndHour" />
                                <span asp-validation-for="EndHour"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="SelectedDayIds" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="SelectedDayIds" asp-items="Model.AvailableDays" asp-multiple="true" asp-required="true" />
                                <script>
                                    $(document).ready(function () {
                                        var categoryIdsInput = $('#@Html.IdFor(model => model.SelectedDayIds)').data("kendoMultiSelect");
                                        categoryIdsInput.setOptions({
                                            autoClose: false,
                                            filter: "contains"
                                        });

                                    @if (Model.AvailableDays.Count == 0)
                                    {
                                            <text>
                                                    categoryIdsInput.setOptions({
                                                        enable: false
                                                    });
                                                categoryIdsInput._placeholder();
                                                categoryIdsInput._enable();
                                            </text>
                                    }
                                                                                                                                                                                                                                                                                                                                                                                });
                                </script>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ShippingMethodIds" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="ShippingMethodIds" asp-items="Model.AvailableShippingMethod" asp-multiple="true" asp-required="true" />
                                <script>
                                    $(document).ready(function () {
                                        var categoryIdsInput = $('#@Html.IdFor(model => model.ShippingMethodIds)').data("kendoMultiSelect");
                                        categoryIdsInput.setOptions({
                                            autoClose: false,
                                            filter: "contains"
                                        });

                                    @if (Model.AvailableShippingMethod.Count == 0)
                                    {
                                                <text>
                                                        categoryIdsInput.setOptions({
                                                            enable: false
                                                        });
                                                    categoryIdsInput._placeholder();
                                                    categoryIdsInput._enable();
                                                </text>
                                    }
                                                                                                                                                                                                                                                                                                                                                                                });
                                </script>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DisplayOrder" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DisplayOrder" />
                                <span asp-validation-for="DisplayOrder"></span>
                            </div>
                        </div>
                    </div>
                </nop-card>
            </nop-cards>
        </div>
    </div>
</section>



<script>
    $(document).ready(function () {
        $("#StartHour").kendoTimePicker({
            culture: "en-US",
            format: "HH:mm:ss",          // نمایش
            valueFormat: "HH:mm:ss",    // مقدار ارسالی به سرور
            parseFormats: ["HH:mm:ss"],
            popup: {
                position: "bottom right",
                origin: "top right"
            }
        });

        $("#EndHour").kendoTimePicker({
            culture: "en-US",
            format: "HH:mm:ss",          // نمایش
            valueFormat: "HH:mm:ss",    // مقدار ارسالی به سرور
            parseFormats: ["HH:mm:ss"],
            popup: {
                position: "bottom right",
                origin: "top right"
            }
        });

    });
</script>