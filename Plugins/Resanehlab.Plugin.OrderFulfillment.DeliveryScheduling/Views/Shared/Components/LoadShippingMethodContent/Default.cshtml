                    url: '@Url.Action("LoadAvailableDeliveryDateTimesTable", "DeliveryScheduling")',
                    data: { selectedShippingOption: $(this).val(), isOpc: '@Model.IsOpc' },
                    type: 'post',
                    success: function (data) {
                        $("#available-delivery-datetimes").html(data);
                    },
                    complete: {},
                    error: {}
                });
            });

            $(document).on("click", ".delivery-time-table input[type=radio]", function () {
                $(".delivery-time-table td.selected").removeClass("selected");
