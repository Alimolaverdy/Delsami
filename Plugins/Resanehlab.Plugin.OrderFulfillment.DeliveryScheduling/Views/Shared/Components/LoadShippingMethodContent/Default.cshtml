        });
    </script>
}

@if (Model.IsOpc)
{
    @await Html.PartialAsync("~/Plugins/Delsami.OrderFulfillment.DeliveryScheduling/Views/Shared/_OpcShippingMethodOverrideNextButtonAction.cshtml")
}
else
{
    @await Html.PartialAsync("~/Plugins/Delsami.OrderFulfillment.DeliveryScheduling/Views/Shared/_ShippingMethodOverrideNextButtonAction.cshtml")
}
