@model CustomerNavigationModel
@{
    var controllerName = Url.ActionContext.RouteData.Values["controller"].ToString();
    var actionName = Url.ActionContext.RouteData.Values["action"].ToString();

    var selected = false;
    if (controllerName.Equals("customer", StringComparison.InvariantCultureIgnoreCase) &&
        actionName.Equals("ChangePhonenumber", StringComparison.InvariantCultureIgnoreCase))
    {
        selected = true;
    }

    Html.AppendCssFileParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Pavilion/Content/Style.css");
    Html.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Pavilion/Content/Script.js");
}
<li class="change-phonenumber @(selected ? "active" : "inactive")">
    <a href="/ChangePhonenumber" class="">تغییر شماره موبایل</a>
</li>

@if (selected)
{
    <script asp-location="Footer">
        $(document).ready(function () {
            $(".customer-info").addClass("inactive");
            $(".customer-info").removeClass("active");
        });
    </script>
}
