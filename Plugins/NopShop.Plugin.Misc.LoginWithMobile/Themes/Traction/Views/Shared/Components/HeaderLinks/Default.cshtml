                        <a href="@Url.RouteUrl("ShoppingCart")" class="ico-cart">
                            <img src="/icons/ZarIran-icon-pack/Cart-Empty.svg" />
                            <span class="label">@T("ShoppingCart")</span>
                        </a>
                    }

                    @await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))

