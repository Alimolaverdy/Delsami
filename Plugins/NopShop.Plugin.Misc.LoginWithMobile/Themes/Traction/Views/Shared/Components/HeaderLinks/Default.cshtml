}


@if (isShoppingCartPage || isCheckoutPage)
{
    <div class="@(isCheckoutPage ? "checkout-page" : "") header-cart-button-mobile">
        <div class="d-flex">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderLinksBefore, additionalData = Model })
            <!-- Home -->
            <div class="header-cart-mobile-item p-1 flex-fill-100 checkout-buttons">
                @if (isCheckoutPage)
                {
                    <div class="loading-container">@T("Checkout.PleaseWait")</div>
                }
                <div class="fake-buttons-container" style="@(isCheckoutPage ? "display:none" : "")">
                    @{
                        if (isCheckoutPage)
                        {
                            <button type="button" class="button-1 next-step-button continue-to-shpping-methods">@T("Checkout.ContinueToShppingMethods")</button>
                            <button type="button" class="button-1 next-step-button continue-to-payment-methods">@T("Checkout.ContinueToPaymentMethods")</button>
                        }
                    }
                    <button type="submit" class="button-1 fake-checkout-button">
                        @(isCheckoutPage? T("Checkout.ConfirmButton").Text: T("Checkout.Button").Text)
                    </button>
                </div>
            </div>

            <div class="header-cart-mobile-item menu-title p-1 flex-fill-100">
                <tr class="order-total">
                    <td class="cart-total-left">
                        <label></label>
                    </td>
                    <td class="cart-total-right">
                        <span class="value-summary order-total-value-mobile"><strong></strong></span>
                    </td>
                </tr>
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderLinksAfter, additionalData = Model })
        </div>
    </div>

    <script asp-location="Footer">
        $(document).ready(function () {
            let isNoData = jQuery('.no-data').length > 0;
            if (isNoData) {
                let isNoDataInterval = setInterval(function () {
                    if (jQuery('.header-cart-button-mobile:has(.fake-checkout-button)').length > 0) {
                        jQuery('.header-cart-button-mobile:has(.fake-checkout-button)').hide();
                        clearInterval(isNoDataInterval);
                    }
                }, 100);
            }

                @if (isShoppingCartPage)
                {
                        <Text>

                            var price = $(".order-total .value-summary").first().text();
                            if (!price)
                                price = $(".order-total .cart-total-right").first().text();

                            if (!price)
                                price = $($(".cart-total-row.order-total span")[0]).text();


                            if (price) {
                                $(".order-total-value-mobile").text(price)
                            }
                        </Text>
                }

                $(".fake-checkout-button").on("click", function () {
                    @if (isShoppingCartPage)
                    {
                            <Text>
                                $("button#checkout").click();
                            </Text>
                    }
                    else if (isCheckoutPage)
                    {
                            <Text>
                                $(".fake-buttons-container").hide();
                                $(".order-total-value-mobile").text("@T("Checkout.RedirectToIPG")")
                                $("button.confirm-order-next-step-button").click();
                            </Text>
                    }
                });

        });
    </script>
}
