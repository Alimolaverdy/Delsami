@model LoginMobileModel
@using Nop.Core
@using Nop.Core.Domain.Customers
@using Nop.Web.Components;
@using NopShop.Plugin.Misc.LoginWithMobile.Models

@inject IWebHelper webHelper
@inject INopHtmlHelper NopHtml
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("ویرایش شماره موبایل").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-customer-info-page");

    NopHtml.AppendCssFileParts("~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Traction/Content/Style.css");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Traction/Content/Script.js");
}

@section left
    {
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = CustomerNavigationEnum.DownloadableProducts })
}

<div class="page account-page change-password-page">
    <div class="page-title">
        <h1>@T("Account.MyAccount") - ویرایش شماره موبایل</h1>
    </div>
    <div class="page-body">
        <form asp-route="ChangePhonenumber" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post">
            <div class="form-fields change-phonenumber-holder">
                <div class="title">
                    <strong>@T("Account.Login.ReturningCustomer")</strong>
                </div>
                <div asp-validation-summary="ModelOnly" class="message-error"></div>
                <div class="activation-code-description">
                    شماره موبایل فعال شما @Model.ActiveUserName
                </div>
                <div class="activation-code-description">
                    برای تغییر آن شماره مورد نظر را وارد کرده و درخواست کد فعال سازی بدهید
                </div>
                <div class="inputs">
                    <label asp-for="Username" asp-postfix=":" class="input-name">شماره موبایل</label>
                    <input asp-for="Username" placeholder="09xxxxxxxxx" class="login-input username" dir="ltr" maxlength="11" />
                    <span asp-validation-for="Username"></span>
                </div>
                @if (Model.DisplayCaptcha)
                {
                    <div class="captcha-box">
                        <nop-captcha />
                    </div>
                }
            </div>
            <div class="buttons center-align">
                <input type="submit" class="button-1 change-password-button" value="دریافت کد فعال سازی" />
            </div>
        </form>
    </div>
</div>