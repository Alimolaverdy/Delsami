@model LoginMobileModel
@using Nop.Core
@using Nop.Core.Domain.Customers
@using NopShop.Plugin.Misc.LoginWithMobile.Models
@using Nop.Services.Localization

@inject IWebHelper webHelper
@inject IThemeContext themeContext
@inject IStoreContext storeContext
@inject ILocalizationService localizationService
@inject INopHtmlHelper NopHtml
@{
    bool isCalledAsHeaderPanel = !string.IsNullOrEmpty(this.Context.Request.Query["isHeaderPanel"]);
    Layout = isCalledAsHeaderPanel ? "" : "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Login").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-login-page");

    NopHtml.AppendCssFileParts("~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Traction/Content/Style.css");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Traction/Content/Script.js");
}
<div class="page login-page">
    <div class="page-body">
        <div class="customer-blocks">
            @if (Model.RegistrationType == UserRegistrationType.Disabled)
            {
                <div class="new-wrapper">
                    <div class="title">
                        @T("Account.Register")
                    </div>
                    <div class="text">
                        @T("Account.Register.Result.Disabled")
                    </div>
                </div>
            }
            else
            {
                <div class="returning-wrapper fieldset">
                    <div class="phonenumber-holder">
                        <form asp-route="Login"
                              asp-route-returnurl="@Context.Request.Query["ReturnUrl"]"
                              asp-route-referralCode="@Context.Request.Query["referralCode"]"
                              method="post">

                            <div class="logo">
                                <img src="/images/logo-main-notext.svg" />
                            </div>
                            <div class="title">
                                <h1>
                                    ورود | ثبت نام
                                </h1>
                            </div>
                            <div class="login-hint">
                                لطفا شماره موبایل خود را وارد کنید.
                            </div>
                            @{
                                var logoPath = $"~/Themes/{themeContext.GetWorkingThemeNameAsync().Result}/Content/img/logo.png";
                                var themeLogo = await Component.InvokeAsync("Widget", new { widgetZone = "emporium_theme_logo" });
                            }

                            <div class="mobile-login-logo">
                                <a href="@Url.RouteUrl("Homepage")" class="logo">
                                    @if (!String.IsNullOrEmpty(themeLogo.ToString()))
                                    {
                                        @themeLogo
                                    }
                                    else
                                    {
                                        string storeName = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), x => x.Name);
                                        <img title="" alt="@storeName" src="@Url.Content(logoPath)">
                                    }
                                </a>
                            </div>

                            <div class="form-fields">
                                <div class="inputs">
                                    <input asp-for="Username" type="tel" class="username" autofocus="autofocus" dir="ltr" placeholder="09xxxxxxxxx" ma_length="11" />
                                    <span class="inputs-icons">&#x61;</span>
                                    <span asp-validation-for="Username"></span>
                                    <div asp-validation-summary="ModelOnly" class="message-error"></div>
                                </div>
                                @if (Model.DisplayCaptcha)
                                {
                                    <div class="captcha-box">
                                        <nop-captcha />
                                    </div>
                                }
                            </div>
                            <div class="policy" style="text-align:center;">
                                <a href="/privacy-notice">@T("Plugin.Misc.LoginWithMobile.PrivacyText")</a>
                            </div>
                            <div class="buttons btn-active-code-holder">
                                <input class="button-1 login-button" type="submit" value="ادامه" />
                            </div>

                            @if (Model.EnableLoginWithEmail)
                            {
                                <div class="login-with-email-a-holder">
                                    <a href="@Url.RouteUrl("Plugin.Misc.LoginWithMobile.LoginWithEmail", new { returnUrl = this.Context.Request.Query["returnUrl"] })" class="login-with-email-a">ورود با پست الکترونیکی</a>
                                </div>
                            }
                            <div class="login-description-holder">
                                @Html.Raw(Model.LoginDescription)
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<style>
    .phonenumber-holder {
        width: 100% !important;
    }
</style>