@model ActivationCodeModel
@using Nop.Core
@using Nop.Core.Domain.Customers
@using NopShop.Plugin.Misc.LoginWithMobile.Models

@inject IWebHelper webHelper
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("تغییر شماره موبایل").Text);
    //page class
    Html.AppendPageCssClassParts("html-account-page");
    Html.AppendPageCssClassParts("html-customer-info-page");

    Html.AppendCssFileParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Minimal/Content/Style.css");
    Html.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Minimal/Content/Script.js");
    Html.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopShop.Misc.LoginWithMobile/Themes/Minimal/Content/ChangeActivationCodeScript.js");

}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = CustomerNavigationEnum.Info })
}

<div class="page account-page change-password-page">
    <div class="page-title">
        <h1>ویرایش شماره موبایل</h1>
    </div>
    <div class="page-body">
        <form asp-route="ActivationCode" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post">
            @Html.HiddenFor(model => model.Username)
            @Html.HiddenFor(model => model.ReturnUrl)
            <div class="fieldset">
                <div asp-validation-summary="ModelOnly" class="message-error"></div>
                <div class="title">
                    <strong>کد فعال سازی را وارد کنید</strong>
                </div>
                <div class="activation-code-description">
                    کد فعال سازی به شماره موبایل @Model.Username ارسال شده است
                </div>
                <div class="form-fields">
                    <div class="inputs">
                        <label asp-for="ActivationCode" asp-postfix=":">کد فعال سازی</label>
                        <input asp-for="ActivationCode" type="tel" dir="ltr" maxlength="6" class="username" autofocus="autofocus" />
                        <span class="inputs-icons">&#x61;</span>
                        <span asp-validation-for="ActivationCode"></span>
                    </div>
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="captcha-box">
                            <nop-captcha />
                        </div>
                    }
                    <div id="timer-decription" class="center-align">
                        ارسال مجدد کد فعال سازی تا
                        <span id="timer">
                            00:00
                        </span>
                        دیگر
                    </div>
                    <div class="center-align">
                        <a id="send-activation-code-again" class="login-with-email-a lwm-display-no center-align">ارسال دوباره کد فعال سازی</a>
                    </div>
                </div>
                <div class="buttons center-align btn-login-holder">
                    <input class="button-1 login-button" type="submit" value="تغییر شماره موبایل" />
                </div>
            </div>
        </form>
    </div>
</div>

<input type="hidden" id="countDownDate" />

<input type="hidden" id="ActivationCodeExpiredDateYear" value="@Model.ActivationCodeExpiredDate.Year" />
<input type="hidden" id="ActivationCodeExpiredDateMonth" value="@Model.ActivationCodeExpiredDate.Month" />
<input type="hidden" id="ActivationCodeExpiredDateDay" value="@Model.ActivationCodeExpiredDate.Day" />
<input type="hidden" id="ActivationCodeExpiredDateHour" value="@Model.ActivationCodeExpiredDate.Hour" />
<input type="hidden" id="ActivationCodeExpiredDateMinute" value="@Model.ActivationCodeExpiredDate.Minute" />
<input type="hidden" id="ActivationCodeExpiredDateSecond" value="@Model.ActivationCodeExpiredDate.Second" />

