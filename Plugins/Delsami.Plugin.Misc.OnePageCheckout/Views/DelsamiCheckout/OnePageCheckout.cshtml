                                    @if (bwdkEnabled && !isRestricted)
                                    {
                                        <script src="https://digifycdn.com/front-statics/digify-bwdk-ui-kit/widget-sdk.min.js" Data-digify-widget async></script>

                                        <div class="cart">
                                            <digify-clickable-box id="widget"></digify-clickable-box>
                                        </div>
                                        <script>
                                                                                       (() => {

                                                const widgetElement = document.getElementById("widget");

                                                // Prevent duplicate event registration
                                                if (widgetElement && !widgetElement.dataset.orderEventBound) {

                                                    widgetElement.dataset.orderEventBound = "true";

                                                    widgetElement.addEventListener("click", async () => {

                                                        // Prevent double submission
                                                        if (widgetElement.dataset.submitting === "true")
                                                            return;

                                                        widgetElement.dataset.submitting = "true";

                                                        try {
                                                            const response = await fetch(
                                                                "/DigiKalaShopping/CreateOrder"
                                                            );

                                                            if (!response.ok) {
                                                                alert("خطا در ثبت سفارش با دیجی کالا");
                                                                return;
                                                            }

                                                            const dataJson = await response.json();

                                                            if (!dataJson.isSuccess) {
                                                                alert(dataJson.message);
                                                                return;
                                                            }

                                                            window.location.href = dataJson.data;

                                                        } catch (error) {

                                                            console.error("CreateOrder error:", error);
                                                            alert("خطایی در ارتباط با سرور رخ داد");

                                                        } finally {

                                                            delete widgetElement.dataset.submitting;

                                                        }
                                                    });
                                                }

                                                // Initialize Digify Widget
                                                const initWidget = () => {

                                                    const widget = window.DigifyWidget?.default;

                                                    if (!widget?.init) {
                                                        console.error("Digify widget SDK failed to load");
                                                        return;
                                                    }

                                                    widget.init();
                                                };

                                                if (window.DigifyWidget?.default?.init) {

                                                    initWidget();

                                                } else {

                                                    const sdkScript = document.querySelector(
                                                        "script[data-digify-widget]"
                                                    );

                                                    if (sdkScript) {
                                                        sdkScript.addEventListener(
                                                            "load",
                                                            initWidget,
                                                            { once: true }
                                                        );
                                                    }
                                                }

                                            })();

                                        </script>
                                    }
