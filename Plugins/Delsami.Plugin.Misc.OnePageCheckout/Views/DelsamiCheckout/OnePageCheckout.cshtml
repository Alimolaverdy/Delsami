    @model OnePageCheckoutModel
@using Nop.Core
@using Nop.Services.Customers
@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject ICustomerService _customerService
@inject ISettingService settingService
@{
    Layout = "_ColumnsOne";

    var storeLocation = webHelper.GetStoreLocation();

    //title
    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-checkout-page");
    var bwdkEnabled = settingService.GetSettingByKey<bool>("digikalashoppingsettings.enabled");
    var restrictedRoles = settingService.GetSettingByKey<string>("digikalashoppingsettings.SelectedRestrictRoleIds")
                                    ?.Split("-")
                                     ?.Select(a => int.Parse(a))
                                     .ToList() ?? new(); ;

    var customer = await workContext.GetCurrentCustomerAsync();
    var customerRoleIds = await _customerService.GetCustomerRoleIdsAsync(customer);

    var isRestricted = customerRoleIds.Any(x => restrictedRoles.Contains(x));
}

