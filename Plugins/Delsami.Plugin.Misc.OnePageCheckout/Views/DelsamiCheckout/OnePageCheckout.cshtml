                $(document).on({
                    ajaxStart: function (event, xhr, settings) {
                        const url = settings?.url?.toLowerCase() || "";

                        // مسیرهایی که نمی‌خوای لودر نمایش بده
                        if (url.includes("/catalog/searchtermautocomplete")) {
                            return;
                        }

                        activeAjaxRequests++;
                        clearTimeout(ajaxTimeout);

                        // نمایش لودر
                        $("#global-loader").css("display", "flex");

                        // 🔒 قفل کردن اسکرول
                        $("body").css({
                            "overflow": "hidden",
                            "height": "100vh"
                        });
