@model TicketDepartmentAdminModel

@{
    NopHtml.SetActiveMenuItemSystemName("SevenSpikes.HelpDesk.Admin.Submenus.TicketDepartments");
}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="form-horizontal">
        @await Html.TrialMessageAsync(Model.IsTrialVersion, Plugin.Name, Plugin.UrlInStore, "The trial is limited to only 1 ticket department.")
        
        <nop-tabs id="nop-help-desk-ticket-department">
            <nop-tab asp-name="tab-general-settings" asp-default="true" asp-title="@T("SevenSpikes.HelpDesk.Admin.TicketDepartment.Settings")">
                @await Html.PartialAsync("Settings", Model)
            </nop-tab>
            @if (Model.Id > 0)
            {
                <nop-tab asp-name="tab-staff-settings" asp-title="@T("SevenSpikes.HelpDesk.Admin.TicketDepartment.Staff")">
                    @await Html.PartialAsync("StaffList", Model)
                </nop-tab>
            }
        </nop-tabs>
    </div>
</section>