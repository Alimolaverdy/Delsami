@model TicketAttributeAdminListModel
    
@inject AdminAreaSettings adminAreaSettings

@{
    Layout = AdminViewLocations.AdminLayoutViewPath;

    NopHtml.SetActiveMenuItemSystemName("SevenSpikes.HelpDesk.Admin.Submenus.TicketAttributes");

    var defaultGridPageSize = adminAreaSettings.DefaultGridPageSize;
    var gridPageSizes = adminAreaSettings.GridPageSizes;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("SevenSpikes.HelpDesk.Admin.TicketAttribute")
    </h1>
    <div class="float-right">
        <a href="@Url.Action("Create")" class="btn bg-primary">
            <i class="fa fa-plus-square"></i>
            @T("SevenSpikes.HelpDesk.Admin.TicketAttribute.AddNew")
        </a>
    </div>
</div>

<nop-antiforgery-token />

<section class="content">
    <div class="form-horizontal">
        
        @await Html.TrialMessageAsync(Model.IsTrialVersion, Plugin.Name, Plugin.UrlInStore)

        <div class="cards-group">
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
			   {
				   Name = "ticket-attributes-grid",
				   UrlRead = new DataUrl("List", "HelpDeskTicketAttributeAdmin", null),
				   UrlDelete = new DataUrl("DeleteTicketAttribute", "HelpDeskTicketAttributeAdmin", null),
				   Length = defaultGridPageSize,
				   LengthMenu = gridPageSizes,
				   ColumnCollection = new List<ColumnProperty>
						{
							new ColumnProperty(nameof(TicketAttributeAdminModel.Name))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.Name").Text
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.AttributeControlType))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.AttributeControlType").Text
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.IsRequired))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.IsRequired").Text,
								Render = new RenderCustom("renderIsRequired"),
								Width = "100"
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.IsAdminAttribute))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.IsAdminAttribute").Text,
								Render = new RenderCustom("renderIsAdminAttribute"),
								Width = "100"
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.IsFilterable))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.IsFilterable").Text,
								Render = new RenderCustom("renderIsFilterable"),
								Width = "100"
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.DisplayOrder))
							{
								Title = T("SevenSpikes.HelpDesk.Admin.TicketAttribute.DisplayOrder").Text,
								Width = "100"
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.Id))
							{
								Width = "100",
								Render = new RenderCustom("renderEditButton")
							},
							new ColumnProperty(nameof(TicketAttributeAdminModel.Id))
							{
								Width = "100",
								Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
							}
						}
			   })
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript" asp-location="Footer">

    function renderIsRequired(data, type, row, meta) {

        if (row.IsRequired) {

            return '<i class="fa fa-check true-icon"></i>';
        }
        else {

            return '<i class="fa fa-times false-icon"></i>';
        }
    }

    function renderIsAdminAttribute(data, type, row, meta) {

        if (row.IsAdminAttribute) {

            return '<i class="fa fa-check true-icon"></i>';
        }
        else {

            return '<i class="fa fa-times false-icon"></i>';
        }
    }

    function renderIsFilterable(data, type, row, meta) {

        if (row.IsFilterable) {

            return '<i class="fa fa-check true-icon"></i>';
        }
        else {

            return '<i class="fa fa-times false-icon"></i>';
        }
    }

    function renderEditButton(data, type, row, meta) {

        return '<a class="btn btn-default" href="Edit/' + data + '" title="@T("Admin.Common.Edit")">' +
            '<i class="fas fa-pencil-alt"></i>' +
            '@T("Admin.Common.Edit")' +
            '</a>';
    }

    var dataSource = @Html.ToLocalDatabase(Model.AvailableAttributeControlTypes)

    function AttributeControlTypeFilter(element) {
        element.kendoDropDownList({
            dataTextField: "text",
            dataValueField: "value",
            dataSource: dataSource,
            optionLabel: helpDeskResources.sevenSpikesHelpDeskSelectValue
        });
    }
</script>