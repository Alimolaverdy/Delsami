                </li>
                <li class="box-row">
                    <label class="row-label">@T("SevenSpikes.HelpDesk.Public.Ticket.Customer"):</label>
                    <span><a class="row-text" href="@Url.RouteUrl("HelpDeskManageTickets")?customerId=#= CustomerId #">#= CustomerName # ( Id: #= CustomerId # )</a></span>
                </li>

                # if (AssignedBy !== 0) { #
