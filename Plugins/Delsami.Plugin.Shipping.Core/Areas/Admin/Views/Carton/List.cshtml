@model CartonSearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Delsami.Plugin.Misc.ShippingCore.Admin.Carton.List").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(T("Delsami.Plugin.Misc.ShippingCore.Admin.Carton.List.SystemName").Text);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Delsami.Plugin.Misc.ShippingCore.Admin.Carton.List")
    </h1>

    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "carton-grid",
                            UrlRead = new DataUrl("List", "Carton", new RouteValueDictionary{{"Area","Admin"}}),
                            SearchButtonId = "search-carton",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {

                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(CartonModel.Name))
                                {
                        Title = T("Delsami.Plugin.Misc.ShippingCore.Admin.CartonModel.Name").Text,
                                    ClassName =  NopColumnClassDefaults.CenterAll,
                                    Width = "100"
                                },
                                new ColumnProperty(nameof(CartonModel.Width))
                                {
                        Title = T("Delsami.Plugin.Misc.ShippingCore.Admin.CartonModel.Width").Text,
                                    ClassName =  NopColumnClassDefaults.CenterAll,
                                    Width = "80"
                                },
                                new ColumnProperty(nameof(CartonModel.Height))
                                {
                        Title = T("Delsami.Plugin.Misc.ShippingCore.Admin.CartonModel.Height").Text,
                                    ClassName =  NopColumnClassDefaults.CenterAll,
                                    Width = "80"
                                },
                                new ColumnProperty(nameof(CartonModel.Length))
                                {
                        Title = T("Delsami.Plugin.Misc.ShippingCore.Admin.CartonModel.Length").Text,
                                    ClassName =  NopColumnClassDefaults.CenterAll,
                                    Width = "80"
                                },
                                new ColumnProperty(nameof(CartonModel.PostBoxNumber))
                                {
                        Title = T("Delsami.Plugin.Misc.ShippingCore.Admin.CartonModel.PostBoxNumber").Text,
                                ClassName =  NopColumnClassDefaults.CenterAll,
                                Width = "80"
                                },
                                new ColumnProperty(nameof(CartonModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "80",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("Edit"))
                                }
                            }
                        })

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

