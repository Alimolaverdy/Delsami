@model ReminderListModel

@inject AdminAreaSettings adminAreaSettings

@{
    Layout = AdminViewLocations.AdminLayoutViewPath;

    var defaultGridPageSize = adminAreaSettings.DefaultGridPageSize;
    var gridPageSizes = adminAreaSettings.GridPageSizes;

    NopHtml.SetActiveMenuItemSystemName("SevenSpikes.Plugins.CustomerReminders.Admin.Submenus.ManageReminders");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("SevenSpikes.Plugins.CustomerReminders")
    </h1>
    <div class="float-right">
        <a href="Create" class="btn bg-primary">
            <i class="fa fa-plus-square"></i>
            @T("SevenSpikes.Plugins.CustomerReminders.Admin.Reminder.AddNew")
        </a>
    </div>
</div>

<nop-antiforgery-token/>

<section class="content">
    <div class="form-horizontal">
        @await Html.TrialMessageAsync(Model.IsTrialVersion, Plugin.Name, Plugin.UrlInStore, $"You can send up to 100 messages using this trial version. Number of messages sent so far: {Model.NumberOfSentMessages}")

        <div class="cards-group">
            <div class="card card-default">
                <div class="card-body">
                    @{ 
                        await Html.RenderPartialAsync("Table", new DataTablesModel
                        {
                            Name = "reminders-grid",
                            UrlRead = new DataUrl("List", "CustomerRemindersAdmin", null),
                            UrlDelete = new DataUrl("Delete", "CustomerRemindersAdmin", null),
                            Length = defaultGridPageSize,
                            LengthMenu = gridPageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(ReminderModel.Name))
                                { 
                                    Title = T("SevenSpikes.Plugins.CustomerReminders.Admin.Reminder.Name").Text,
                                    Width = "300"
                                },
                                new ColumnProperty(nameof(ReminderModel.MessageTemplateName))
                                { 
                                    Title = T("SevenSpikes.Plugins.CustomerReminders.Admin.Reminder.MessageTemplateName").Text,
                                    Width = "300"
                                },
                                new ColumnProperty(nameof(ReminderModel.Id))
                                { 
                                    Render = new RenderCustom("renderEditButton"),
                                    Width = "100"
                                },
					            new ColumnProperty(nameof(ReminderModel.Id))
					            {
						            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                    Width = "100"
					            }
                            }
                        });
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>

    function renderEditButton(data, type, row, meta) {

        return '<a class="btn btn-default" href="Edit/' + data + '" title="@T("Admin.Common.Edit")">' +
            '<i class="fas fa-pencil-alt"></i>' +
            '@T("Admin.Common.Edit")' +
            '</a>';
    }

</script>