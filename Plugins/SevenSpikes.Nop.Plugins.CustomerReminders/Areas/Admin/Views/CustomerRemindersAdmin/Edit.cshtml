@model ReminderModel

@{
    Layout = AdminViewLocations.AdminLayoutViewPath;

    NopHtml.SetActiveMenuItemSystemName("SevenSpikes.Plugins.CustomerReminders.Admin.Submenus.ManageReminders");
}

<form method="post" id="sale-campaign-form">
    <nop-antiforgery-token />

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("SevenSpikes.Plugins.CustomerReminders.Admin.Reminder.EditReminderDetails")
            <small><i class="fa fa-arrow-circle-left"></i> - @Model.Name @Html.ActionLink("(" + T("SevenSpikes.Plugins.CustomerReminders.Admin.Reminder.BackToList") + ")", "List")</small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-primary save-settings-button">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-primary save-settings-button">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @if (Model.Id > 0)
            {
                <span id="reminder-delete" class="btn bg-danger">
                    <i class="far fa-trash-alt"></i>
                    @T("Admin.Common.Delete")
                </span>
            }
        </div>
    </div>

    @{ await Html.RenderPartialAsync("_CreateOrUpdate", Model); }

</form>

<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="reminder-delete" />