@model Delsami.Plugin.Widgets.AddressLocation.Areas.Admin.Models.ConfigurationModel
@{
	Layout = "_ConfigurePlugin";
	NopHtml.SetActiveMenuItemSystemName("AddressLocationConfiguration");
}

<form asp-controller="AddressLocation" asp-action="Configure" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="cards-group">
				<div class="card card-default">
					<div class="card-body">
						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="LatitudeAddressAttributeId" />
							</div>
							<div class="col-md-9">
								<nop-select asp-for="LatitudeAddressAttributeId" asp-items="Model.AvailableAddressAttributes" />
								<span asp-validation-for="LatitudeAddressAttributeId"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="LongitudeAddressAttributeId" />
							</div>
							<div class="col-md-9">
								<nop-select asp-for="LongitudeAddressAttributeId" asp-items="Model.AvailableAddressAttributes" />
								<span asp-validation-for="LongitudeAddressAttributeId"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="DigiKalaAddressAttributeId" />
							</div>
							<div class="col-md-9">
								<nop-select asp-for="DigiKalaAddressAttributeId" asp-items="Model.AvailableAddressAttributes" />
								<span asp-validation-for="DigiKalaAddressAttributeId"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="NeshanServiceApiKey" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="NeshanServiceApiKey" />
								<span asp-validation-for="NeshanServiceApiKey"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="NeshanMapApiKey" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="NeshanMapApiKey" />
								<span asp-validation-for="NeshanMapApiKey"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="NeshanServiceTimeoutAsMilliseconds" />
							</div>
							<div class="col-md-9">
								<nop-editor asp-for="NeshanServiceTimeoutAsMilliseconds" />
								<span asp-validation-for="NeshanServiceTimeoutAsMilliseconds"></span>
							</div>
						</div>

						<div class="form-group row">
							<div class="col-md-3">
								<nop-label asp-for="MapType" />
							</div>
							<div class="col-md-9">
								<nop-select asp-for="MapType" asp-items="@await ((Model.MapType).ToSelectListAsync())" />
								<span asp-validation-for="MapType"></span>
							</div>
						</div>


						<div class="form-group row">
							<div class="col-md-9 offset-md-3">
								<button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</section>
</form>