@model SaleCampaignModel
    
<link rel="stylesheet" href="~/Plugins/SevenSpikes.Nop.Plugins.SalesCampaigns/Styles/SalesCampaigns.common.css" />

<script>
    $(document).ready(function () {
        var categoryClockTypeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockType)';

        var campaignLabelFontWeightSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockFontWeight)';
        var campaignLabelFontStyleSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockFontStyle)';
        var campaignLabelFontSizeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockFontSize)';
        var campaignLabelFontSizeUnitSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockFontSizeUnit)';
        var campaignLabelFontColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockFontColor).Replace("_", "")';

        var campaignTextFontWeightSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryCampaignTextFontWeight)';
        var campaignTextFontStyleSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryCampaignTextFontStyle)';
        var campaignTextFontSizeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryCampaignTextFontSize)';
        var campaignTextFontSizeUnitSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryCampaignTextFontSizeUnit)';
        var campaignTextFontColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryCampaignTextFontColor).Replace("_", "")';

        var wrapperBackgroundColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperBackgroundColor).Replace("_", "")';
        var wrapperBorderInputSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperBorderInput)';
        var wrapperBorderTypeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperBorderType)';
        var wrapperBorderColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperBorderColor).Replace("_", "")';
        var wrapperPaddingTopSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperPaddingTop)';
        var wrapperPaddingRightSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperPaddingRight)';
        var wrapperPaddingBottomSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperPaddingBottom)';
        var wrapperPaddingLeftSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryWrapperPaddingLeft)';

        var numberBoxBackgroundColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxBackgroundColor).Replace("_", "")';
        var numberBoxBorderInputSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxBorderInput)';
        var numberBoxBorderTypeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxBorderType)';
        var numberBoxBorderColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxBorderColor).Replace("_", "")';
        var numberBoxFontWeightSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxFontWeight)';
        var numberBoxFontStyleSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxFontStyle)';
        var numberBoxFontSizeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxFontSize)';
        var numberBoxFontSizeUnitSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxFontSizeUnit)';
        var numberBoxFontColorSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryNumberBoxFontColor).Replace("_", "")';

        $(categoryClockTypeSelector).change(showNumberBoxFieldset);

        showNumberBoxFieldset();

        $('#clickForCategoryPreview').on('click', function (e) {
            e.preventDefault();
             
            var wrapperSelector = '#campaignWrapper';
            var campaignLabelSelector = '#campaignLabel';
            var campaignTextSelector = '#campaignText';

            var clockType = $(categoryClockTypeSelector).val();

            var campaignLabel = GetCampaignLabel(clockType);
            var campaignText = GetCampaignText(clockType);

            $(campaignLabelSelector).html(campaignLabel);
            $(campaignTextSelector).html(campaignText);

            if (clockType === "DaysHoursMinutesSeconds" || clockType === "HoursMinutesSeconds" || clockType === "OnlyDays") {

                $('.sale-campaign-box').css('background-color', $(numberBoxBackgroundColorSelector).val());
                $('.sale-campaign-box').css('border', $(numberBoxBorderInputSelector).val() + "px " + $(numberBoxBorderTypeSelector).val() + " " + $(numberBoxBorderColorSelector).val());
                $('.sale-campaign-box').css('font-weight', $(numberBoxFontWeightSelector).val());
                $('.sale-campaign-box').css('font-style', $(numberBoxFontStyleSelector).val());
                $('.sale-campaign-box').css('font-size', $(numberBoxFontSizeSelector).val() + $(numberBoxFontSizeUnitSelector).val());
                $('.sale-campaign-box').css('color', $(numberBoxFontColorSelector).val());

                campaignTextSelector = ".sale-campaign-box-label";
            }

            $(wrapperSelector).css('text-align', 'center');
            $(wrapperSelector).css('background-color', $(wrapperBackgroundColorSelector).val());
            $(wrapperSelector).css('border', $(wrapperBorderInputSelector).val() + "px " + $(wrapperBorderTypeSelector).val() + " " + $(wrapperBorderColorSelector).val());
            $(wrapperSelector).css('padding', $(wrapperPaddingTopSelector).val() + 'px ' + $(wrapperPaddingRightSelector).val() + 'px ' + $(wrapperPaddingBottomSelector).val() + 'px ' + $(wrapperPaddingLeftSelector).val() + 'px ');

            $(campaignLabelSelector).css('font-weight', $(campaignLabelFontWeightSelector).val());
            $(campaignLabelSelector).css('font-style', $(campaignLabelFontStyleSelector).val());
            $(campaignLabelSelector).css('font-size', $(campaignLabelFontSizeSelector).val() + $(campaignLabelFontSizeUnitSelector).val());
            $(campaignLabelSelector).css('color', $(campaignLabelFontColorSelector).val());

            $(campaignTextSelector).css('font-weight', $(campaignTextFontWeightSelector).val());
            $(campaignTextSelector).css('font-style', $(campaignTextFontStyleSelector).val());
            $(campaignTextSelector).css('font-size', $(campaignTextFontSizeSelector).val() + $(campaignTextFontSizeUnitSelector).val());
            $(campaignTextSelector).css('color', $(campaignTextFontColorSelector).val());
        });

        function showNumberBoxFieldset() {
            var categoryClockTypeSelector = '#@Html.IdFor(model => model.SaleCampaignCategoryPageCustomization.SaleCampaignCategoryClockType)';
            // Clock type = DaysHoursMinutesSeconds, HoursMinutesSeconds or OnlyDays
            if ($(categoryClockTypeSelector).val() === "5" || $(categoryClockTypeSelector).val() === "10" || $(categoryClockTypeSelector).val() === "15") {
                $(".panel-default.number-box").show();
            } else {
                $(".panel-default.number-box").hide();
            }
        }
    });

    function GetCampaignLabel(clockType) {
        // Clock type = DaysHoursMinutesSeconds, HoursMinutesSeconds or OnlyDays
        if (clockType === "5" || clockType === "10" || clockType === "15") {
            return "@T("SevenSpikes.Plugins.SaleCampaigns.Public.SaleEndsIn")";
        }

        return "@T("SevenSpikes.Plugins.SaleCampaigns.Public.OnSaleUntil")";
    }

    function GetCampaignText(clockType) {
        var campaignText = "";

        switch (clockType) {
            case "DaysHoursMinutesSeconds":
                campaignText = '' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Days")</span></div>' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Hours")</span></div>' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Minutes")</span></div>' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Seconds")</span></div>';
                break;

            case "HoursMinutesSeconds":
                campaignText = '' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Hours")</span></div>' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Minutes")</span></div>' +
                    '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Seconds")</span></div>';
                break;

            case "OnlyDays":
                campaignText = '<div class="sale-campaign-box-wrapper"><span class="sale-campaign-box">#</span><span class="sale-campaign-box-label">@T("SevenSpikes.Plugins.SaleCampaigns.Public.Days")</span></div>';
                break;

            case "LongDate":
                campaignText = "Saturday, January 1, 2014, 0:00:00 AM";
                break;

            case "LongDateWithoutTime":
                campaignText = "Saturday, January 1, 2014";
                break;

            case "ShortDate":
                campaignText = "until 1/1/2014, 0:00 AM";
                break;

            case "ShortDateWithoutTime":
                campaignText = "until 1/1/2014";
                break;
        }

        return campaignText;
    }
</script>

