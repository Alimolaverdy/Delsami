                                        <nop-label asp-for="SaleCampaignProductPageCustomization.MarginLeft" />
                                    </div>
                                    <div class="style-box-item">
                                        <nop-editor asp-for="SaleCampaignProductPageCustomization.MarginLeft" asp-postfix="@T("SevenSpikes.Plugins.Admin.InputStyles.Postfix.Pixels").Text" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row clearfix">
