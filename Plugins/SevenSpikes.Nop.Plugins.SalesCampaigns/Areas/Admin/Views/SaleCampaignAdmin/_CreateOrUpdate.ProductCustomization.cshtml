                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
					<div class="card-title">
						@T("SevenSpikes.Plugins.SaleCampaigns.Admin.Entities.SaleCampaignCustomization.CustomizeYourCSS")
					</div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="SaleCampaignProductPageCustomization.CustomCSS" />
                        </div>
                        <div class="col-md-9">
                            <nop-textarea asp-for="SaleCampaignProductPageCustomization.CustomCSS" />
                        </div>
                    </div>
                    <div class="form-group row clearfix">
                        <div class="col-md-9 col-md-offset-3">
                            <div class="callout bg-gray-light">
                                @T("SevenSpikes.Plugins.SaleCampaigns.Admin.Entities.SaleCampaignCustomization.CustomizeYourCSS.Text")<br />
                                @T("SevenSpikes.Plugins.SaleCampaigns.Admin.Entities.SaleCampaignCustomization.CustomizeYourCSS.Example")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
					<div class="card-title">
						@T("SevenSpikes.Plugins.SaleCampaigns.Admin.Entities.SaleCampaignCustomization.Preview")
