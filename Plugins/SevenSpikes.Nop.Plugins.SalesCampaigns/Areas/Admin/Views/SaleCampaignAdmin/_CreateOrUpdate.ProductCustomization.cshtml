@model SaleCampaignModel

<script>
    $(document).ready(function () {
        $('#clickForPreview').on('click', function (e) {
            e.preventDefault();

            var previewClockSelector = '#previewClock';

            var selectedClockType = $('#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.ClockType)').val();
            var fontWeightSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.FontWeight)';
            var fontStyleSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.FontStyle)';
            var fontSizeSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.FontSize)';
            var textAlignSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.ClockTextAlign)';
            var fontColorSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.FontColor).Replace("_", "")';
            var backgroundColorSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.BackgroundColor).Replace("_", "")';

            var paddingTopSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.PaddingTop)';
            var paddingRightSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.PaddingRight)';
            var paddingBottomSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.PaddingBottom)';
            var paddingLeftSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.PaddingLeft)';

            var marginTopSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.MarginTop)';
            var marginRightSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.MarginRight)';
            var marginBottomSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.MarginBottom)';
            var marginLeftSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.MarginLeft)';

            var customCSSSelector = '#@Html.IdFor(model => model.SaleCampaignProductPageCustomization.CustomCSS)';

            $(previewClockSelector).text($('#SaleCampaignProductPageCustomization_ClockType option[value=' + selectedClockType + ']').text());
            $(previewClockSelector).css('font-size', $(fontSizeSelector).val() + 'px');
            $(previewClockSelector).css('font-weight', $(fontWeightSelector).val());
            $(previewClockSelector).css('font-style', $(fontStyleSelector).val());
            $(previewClockSelector).css('text-align', $(textAlignSelector).val().toLowerCase());
            $(previewClockSelector).css('color', $(fontColorSelector).val());
            $(previewClockSelector).css('background-color', $(backgroundColorSelector).val());
            $(previewClockSelector).css('padding', $(paddingTopSelector).val() + 'px ' + $(paddingRightSelector).val() + 'px ' + $(paddingBottomSelector).val() + 'px ' + $(paddingLeftSelector).val() + 'px ');
            $(previewClockSelector).css('margin', $(marginTopSelector).val() + 'px ' + $(marginRightSelector).val() + 'px ' + $(marginBottomSelector).val() + 'px ' + $(marginLeftSelector).val() + 'px ');

            var splitBySemiColon = $(customCSSSelector).val().split(';');

            for (var i = 0; i < splitBySemiColon.length; i++) {
                var splitByColon = splitBySemiColon[i].trim().split(':');
                $(previewClockSelector).css(splitByColon[0], splitByColon[1]);
            }
        });
    });
</script>


<section class="content">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card" style="box-shadow: none; padding: 0 4px 0 34px;">
                <div class="form-group row">
