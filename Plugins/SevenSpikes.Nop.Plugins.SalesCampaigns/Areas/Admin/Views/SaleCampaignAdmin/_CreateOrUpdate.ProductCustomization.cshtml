                            <nop-label asp-for="SaleCampaignProductPageCustomization.ClockType" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SaleCampaignProductPageCustomization.ClockType" asp-items="Model.SaleCampaignProductPageCustomization.AvailableClockTypes" />
