                                <label class="control-label">@T("SevenSpikes.Plugins.SaleCampaigns.Admin.Entities.SaleCampaignCustomization.MarginSize")</label>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="style-box">
