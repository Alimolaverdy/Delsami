                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SaleCampaignProductPageCustomization.FontStyle" asp-items="Model.SaleCampaignProductPageCustomization.AvailableFontStyles" />
                            <span asp-validation-for="SaleCampaignProductPageCustomization.FontStyle"></span>
                        </div>
                    </div>
                    <div class="form-group row">
