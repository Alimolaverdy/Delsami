@inject SaleCampaignPluginSettings salesCampaignPluginSettings

@{
    var theme = await ThemeHelper.GetPluginThemeAsync(Plugin.FolderName);

    var salesCampaignsCssFilePath = "~/Plugins/SevenSpikes.Nop.Plugins.SalesCampaigns/Themes/" + theme + "/Content/SalesCampaigns.css";
}

<link rel="stylesheet" href="~/Plugins/SevenSpikes.Nop.Plugins.SalesCampaigns/Styles/SalesCampaigns.common.css" />
<link rel="stylesheet" href="@salesCampaignsCssFilePath" />

<script src="~/Plugins/SevenSpikes.Core/Scripts/jquery.json-2.4.min.js" asp-location="Footer"></script>
<script src="~/Plugins/SevenSpikes.Core/Scripts/sevenspikes.core.min.js" asp-location="Footer"></script>
<script src="~/Plugins/SevenSpikes.Nop.Plugins.SalesCampaigns/Scripts/SaleCampaigns.min.js" asp-location="Footer"></script>

<div id="sales-campaign-info"
     data-localization-day="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Day")" data-localization-days="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Days")"
     data-localization-hour="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Hour")" data-localization-hours="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Hours")"
     data-localization-minute="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Minute")" data-localization-minutes="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Minutes")"
     data-localization-second="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Second")" data-localization-seconds="@T("SevenSpikes.Plugins.SaleCampaigns.Public.Seconds")"
     data-productbox-selector="@salesCampaignPluginSettings.ProductBoxSelector" data-productbox-picture-container-selector="@salesCampaignPluginSettings.ProductBoxPictureContainerSelector"
     data-retrieve-sales-campaings-url="@Url.RouteUrl("RetrieveSalesCampaigns")">
</div>