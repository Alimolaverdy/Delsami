@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName(T("Delsami.Plugin.Misc.Core.Configuration.SystemName").Text);
}

<form asp-controller="Core" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="NationalCodeAttributeId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="NationalCodeAttributeId" asp-required="true" />
                                <span asp-validation-for="NationalCodeAttributeId"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="AllProductsCategoryId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="AllProductsCategoryId" asp-required="true" />
                                <span asp-validation-for="AllProductsCategoryId"></span>
                            </div>
                        </div>


                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</form>