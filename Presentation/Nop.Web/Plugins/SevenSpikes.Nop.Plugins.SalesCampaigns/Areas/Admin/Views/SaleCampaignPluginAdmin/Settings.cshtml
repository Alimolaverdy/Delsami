@model SaleCampaignPluginSettingsModel

@{
    Layout = AdminViewLocations.AdminLayoutViewPath;

    NopHtml.SetActiveMenuItemSystemName("SevenSpikes.Plugins.SaleCampaigns.Admin.Submenus.Settings");
}

<form method="post">
    <nop-antiforgery-token />

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("SevenSpikes.Plugins.SaleCampaigns.Admin.Settings")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    
    <section class="content">
        <div class="form-horizontal">
            @await Html.TrialMessageAsync(Model.IsTrialVersion, Plugin.Name, Plugin.UrlInStore)

            @await Component.InvokeAsync("StoreScopeConfiguration")

            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row clearfix">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="EnableSaleCampaigns_OverrideForStore" asp-input="EnableSaleCampaigns" asp-store-scope="Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="EnableSaleCampaigns" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="EnableSaleCampaigns" />
                                <span asp-validation-for="EnableSaleCampaigns"></span>
                            </div>
                        </div>
                        <div class="form-group row clearfix">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ProductBoxSelector_OverrideForStore" asp-input="ProductBoxSelector" asp-store-scope="Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ProductBoxSelector" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ProductBoxSelector" />
                                <span asp-validation-for="ProductBoxSelector"></span>
                            </div>
                        </div>
                        <div class="form-group row clearfix">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="ProductBoxPictureContainerSelector_OverrideForStore" asp-input="ProductBoxPictureContainerSelector" asp-store-scope="Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="ProductBoxPictureContainerSelector" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="ProductBoxPictureContainerSelector" />
                                <span asp-validation-for="ProductBoxPictureContainerSelector"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>