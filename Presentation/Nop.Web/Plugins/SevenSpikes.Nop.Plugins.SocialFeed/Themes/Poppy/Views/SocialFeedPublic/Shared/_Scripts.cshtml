@model SocialNetworkType

@{
    var jsThemePath = "~/Plugins/SevenSpikes.Nop.Plugins.SocialFeed/Themes/poppy/Content/scripts/{0}";
    var jsPluginPath = "~/Plugins/SevenSpikes.Nop.Plugins.SocialFeed/Scripts/{0}";

    var socialFeedJsFilePath = string.Format(jsThemePath, "socialfeed.js");
}

@switch (Model)
{
    case SocialNetworkType.Facebook:

        var masonryJsFilePath = string.Format(jsPluginPath, "masonry.pkgd.min.js");
        var simpleScrollbarJsFilePath = string.Format(jsThemePath, "simple-scrollbar.min.js");

        <script src="@masonryJsFilePath" asp-location="Footer"></script>
        <script src="@simpleScrollbarJsFilePath" asp-location="Footer"></script>

        break;
    case SocialNetworkType.Twitter:

        var slickJsFilePath = string.Format(jsThemePath, "slick.min.js");

        <script src="@slickJsFilePath" asp-location="Footer"></script>

        break;
}

<script src="@socialFeedJsFilePath" asp-location="Footer"></script>