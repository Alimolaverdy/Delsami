@model PriceMatchRequestButtonModel

@{
    var theme =await  ThemeHelper.GetPluginThemeAsync(Plugin.FolderName);

    var kendoVersion = "2020.1.406";

    var kendoCoreJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.core.min.js";
    var kendoUserEventsJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.userevents.min.js";
    var kendoDragAndDropJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.draganddrop.min.js";
    var kendoPopupJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.popup.min.js";
    var kendoWindowJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.window.min.js";
    var kendoFxJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.fx.min.js";
    var kendoNumericTextBoxJsFilePath = $"~/lib/kendo/{kendoVersion}/js/kendo.numerictextbox.min.js";

    var priceMatchCssFilePath = "~/Plugins/SevenSpikes.Nop.Plugins.PriceMatch/Themes/" + theme + "/Content/PriceMatch.css";

    bool supportRtl = (await EngineContext.Current.Resolve<IWorkContext>().GetWorkingLanguageAsync()).Rtl;

    string endpoint = Url.Action("GetPriceMatchRequestForm", "PriceMatch", new { productId = Model.ProductId });

    string title = T("SevenSpikes.PriceMatch.Public.PriceMatchForm.Title", Model.ProductName, Model.ProductPriceFormatted).Text;
}

<link rel="stylesheet" href="@priceMatchCssFilePath" />

@if (supportRtl)
{
    var priceMatchRtlCssFilePath = "~/Plugins/SevenSpikes.Nop.Plugins.PriceMatch/Themes/" + theme + "/Content/PriceMatch.rtl.css";

    <link rel="stylesheet" href="@priceMatchRtlCssFilePath" />
}

<script src="~/Plugins/SevenSpikes.Nop.Plugins.PriceMatch/Scripts/PriceMatch.min.js" asp-location="Footer"></script>
<script src="@kendoCoreJsFilePath" asp-location="Footer"></script>
<script src="@kendoUserEventsJsFilePath" asp-location="Footer"></script>
<script src="@kendoDragAndDropJsFilePath" asp-location="Footer"></script>
<script src="@kendoPopupJsFilePath" asp-location="Footer"></script>
<script src="@kendoWindowJsFilePath" asp-location="Footer"></script>
<script src="@kendoFxJsFilePath" asp-location="Footer"></script>
<script src="@kendoNumericTextBoxJsFilePath" asp-location="Footer"></script>

<div class="price-match-wrapper" data-price-match-endpoint="@Html.Raw(endpoint)" data-price-match-form-title="@title">
    <button type="button" value="@T("SevenSpikes.PriceMatch.Public.PriceMatchButton")" title="@T("SevenSpikes.PriceMatch.Public.PriceMatchButton")" class="button-2 price-match-button">@T("SevenSpikes.PriceMatch.Public.PriceMatchButton")</button>
</div>