@model ProductsModel

@inject IStoreService storeService
@inject IPictureService pictureService
@inject ILocalizationService localizationService;

@{
    ProductsModel model = ViewData["Model"] as ProductsModel;

    var products = model.Products;
    var storeUrl = (await storeService.GetStoreByIdAsync(model.StoreId)).Url;
}

<table border="0" cellspacing="5">

    @{
        for (int i = 0; i < products.Count; i++)
        {
            Product product = products[i];

            //new row after every third element
            if (i % 3 == 0)
            {
                @Html.Raw("<tr>")
            }

            string productName = await localizationService.GetLocalizedAsync(product, x => x.Name);
            string productReviewUrl = storeUrl + "productreviews/" + product.Id;
            string currentProductHtml = string.Empty;

            if (model.IncludePictures)
            {
                var defaultProductPicture = (await pictureService.GetPicturesByProductIdAsync(product.Id, 1)).FirstOrDefault();

                if (defaultProductPicture == null && product.ParentGroupedProductId > 0)
                {
                    defaultProductPicture = (await pictureService.GetPicturesByProductIdAsync(product.ParentGroupedProductId, 1)).FirstOrDefault();
                }

                string pictureUrl = await pictureService.GetPictureUrlAsync(defaultProductPicture.Id, 75, true, storeUrl);

                currentProductHtml += $"<a href=\"{productReviewUrl}\"><img src=\"{pictureUrl}\"/></a><br />";
            }

            currentProductHtml += $"<a href=\"{productReviewUrl}\">{productName}</a>";

            <td style="text-align: center; vertical-align: top; width: 200px;">@Html.Raw(currentProductHtml)</td>

            // close the row in two cases:
            // - after the last element
            // - or if the element is the last in the row (we have 3 products in a row)
            if (i == products.Count - 1 || (i > 0 && i % 3 == 2))
            {
                @Html.Raw("</tr>")
            }
        }
    }

</table>